{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "nyc mocha",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "cypress:open:ct": "cross-env COVERAGE=true npx cypress open --component",
    "cypress:run:ct": "cross-env COVERAGE=true npx cypress run --component",
    "coverage:report": "npx nyc report --reporter=lcov --reporter=text",
    "coverage:open": "npx http-server ./coverage/lcov-report -p 8081"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/js": "^9.37.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-istanbul": "^7.0.1",
    "caniuse-lite": "^1.0.30001757",
    "chai": "^6.2.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "prettier": "3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.9",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react-router": "^7.9.4",
    "recharts": "^3.3.0"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.js",
      "src/**/*.jsx",
      "src/**/*.ts",
      "src/**/*.tsx"
    ],
    "extension": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "report-dir": "./coverage",
    "exclude": [
      "**/*.cy.*",
      "cypress/**",
      "tests/**"
    ]
  },
  "extension": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx"
  ],
  "all": true
}
